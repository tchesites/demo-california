---
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { negocio } from '../data/negocio.js';
import { url } from '../utils/url.js';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = negocio.descricao,
  ogImage,
  noindex: noindexProp,
} = Astro.props;

const siteTitle = title.includes('Califórnia') ? title : `${title} · ${negocio.nome}`;
const canonicalPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonical = new URL(canonicalPath, Astro.site);
const ogImageUrl = ogImage
  ? new URL(ogImage, Astro.site)
  : new URL(url('/og-image.jpg'), Astro.site);
const noindex = noindexProp ?? import.meta.env.PUBLIC_NOINDEX === 'true';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BarberShop',
  name: negocio.nome,
  description: negocio.descricao,
  url: new URL(url('/'), Astro.site).href,
  image: ogImageUrl.href,
  telephone: '+55 51 90000-0000',
  priceRange: negocio.faixaPreco,
  address: {
    '@type': 'PostalAddress',
    streetAddress: negocio.endereco,
    addressLocality: negocio.cidade,
    addressRegion: negocio.estado,
    postalCode: negocio.cep,
    addressCountry: 'BR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: negocio.latitude,
    longitude: negocio.longitude,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday'],
      opens: '09:00',
      closes: '19:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Thursday', 'Friday'],
      opens: '09:00',
      closes: '19:30',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday'],
      opens: '09:30',
      closes: '19:00',
    },
  ],
  sameAs: [negocio.instagramUrl],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Tchê Sites" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#08090a" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={negocio.nome} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Archivo+Black&family=IBM+Plex+Mono:wght@400;500&family=Michroma&display=swap"
      rel="stylesheet"
    />

    <title>{siteTitle}</title>

    <noscript>
      <style>
        [data-reveal] {
          opacity: 1;
          transform: none;
        }
      </style>
    </noscript>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      const header = document.querySelector('[data-header]');
      const onScroll = () => {
        if (!header) return;
        header.classList.toggle('is-scrolled', window.scrollY > 24);
      };
      onScroll();
      addEventListener('scroll', onScroll, { passive: true });

      const reveals = document.querySelectorAll('[data-reveal]');
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        reveals.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        reveals.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
