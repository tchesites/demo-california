---
import { Image } from 'astro:assets';
import { negocio, whatsappLink } from '../data/negocio.js';
import fachada from '../assets/fotos/fachada-noite.jpg';
---

<section class="hero" id="topo">
  <div class="container hero__grid">
    <div class="hero__copy">
      <span class="kicker">Canoas · RS</span>
      <h1>
        A barbearia que<br />
        <span class="hero__destaque">transforma</span><br />
        você.
      </h1>
      <p class="hero__sub">
        Corte, barba e cor na régua.
        <strong>{negocio.notaGoogle.toFixed(1).replace('.', ',')} no Google</strong>
        em {negocio.totalAvaliacoes} avaliações — e uma cadeira esperando por você
        no Centro.
      </p>

      <div class="hero__ctas">
        <a class="btn" href={whatsappLink()} target="_blank" rel="noopener">
          Agendar no WhatsApp
          <svg class="btn__arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2 8h11M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </a>
        <a class="btn btn--ghost" href="#servicos">Ver serviços</a>
      </div>

      <div class="hero__prova">
        <span class="stars" aria-hidden="true">★★★★★</span>
        <strong class="num">{negocio.notaGoogle.toFixed(1).replace('.', ',')}</strong>
        <span>{negocio.totalAvaliacoes} avaliações no Google</span>
      </div>
    </div>

    <div class="hero__foto">
      <Image
        src={fachada}
        alt="Letreiro da Califórnia Barbearia aceso à noite"
        widths={[480, 640, 720]}
        sizes="(max-width: 900px) 100vw, 46vw"
        loading="eager"
        fetchpriority="high"
        format="webp"
      />
      <span class="hero__tag">Letreiro aceso · Rua Sete de Setembro, 480</span>
      <span class="hero__corner hero__corner--tl"></span>
      <span class="hero__corner hero__corner--tr"></span>
      <span class="hero__corner hero__corner--bl"></span>
      <span class="hero__corner hero__corner--br"></span>
    </div>
  </div>

  <div class="hero__rail" aria-hidden="true">
    <span>BARBEARIA · CANOAS</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2.5rem, 6vw, 5.5rem) clamp(3rem, 7vw, 6rem);
    border-bottom: 1px solid var(--linha);
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 78% 20%, rgba(78, 122, 52, 0.18), transparent 45%),
      radial-gradient(circle at 10% 90%, rgba(216, 255, 62, 0.06), transparent 40%);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    padding-right: var(--rail);
  }

  .hero__copy {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .hero h1 {
    margin: 1.1rem 0 1.4rem;
    max-width: 100%;
    font-family: var(--fonte-display);
    font-size: var(--t-hero);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .hero__destaque {
    position: relative;
    color: var(--lima);
    white-space: nowrap;
  }

  .hero__destaque::after {
    content: '';
    position: absolute;
    left: 0.04em;
    right: 0.04em;
    bottom: 0.06em;
    height: 0.055em;
    background: var(--lima);
    opacity: 0.65;
  }

  .hero__sub {
    max-width: 44ch;
    color: var(--cinza);
    font-size: clamp(1rem, 1.2vw, 1.13rem);
  }

  .hero__sub strong {
    color: var(--osso);
    font-weight: 600;
    white-space: nowrap;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .hero__prova {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2.2rem;
    padding-top: 1.3rem;
    border-top: 1px solid var(--linha-osso);
    font-family: var(--fonte-dados);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cinza);
  }

  .hero__prova .num {
    font-size: 1.1rem;
    color: var(--osso);
    letter-spacing: 0;
  }

  .hero__foto {
    position: relative;
    justify-self: end;
    width: 100%;
    max-width: 560px;
    aspect-ratio: 4 / 5;
    background: var(--carvao);
  }

  .hero__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 32%;
    filter: brightness(1.22) contrast(1.06) saturate(1.02);
  }

  .hero__foto::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8, 9, 10, 0.02), rgba(8, 9, 10, 0.42));
    pointer-events: none;
  }

  .hero__tag {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    z-index: 2;
    padding: 0.45rem 0.6rem;
    background: var(--preto);
    border: 1px solid var(--linha);
    font-family: var(--fonte-dados);
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--osso);
  }

  .hero__corner {
    position: absolute;
    z-index: 2;
    width: 26px;
    height: 26px;
    border-color: var(--osso);
    border-style: solid;
    border-width: 0;
  }

  .hero__corner--tl {
    top: -1px;
    left: -1px;
    border-top-width: 2px;
    border-left-width: 2px;
  }

  .hero__corner--tr {
    top: -1px;
    right: -1px;
    border-top-width: 2px;
    border-right-width: 2px;
  }

  .hero__corner--bl {
    bottom: -1px;
    left: -1px;
    border-bottom-width: 2px;
    border-left-width: 2px;
  }

  .hero__corner--br {
    bottom: -1px;
    right: -1px;
    border-bottom-width: 2px;
    border-right-width: 2px;
  }

  .hero__rail {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: var(--rail);
    display: flex;
    align-items: center;
    justify-content: center;
    border-left: 1px solid var(--linha);
  }

  .hero__rail span {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--fonte-dados);
    font-size: 0.54rem;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--cinza);
  }

  @media (max-width: 1000px) {
    .hero__rail {
      display: none;
    }

    .hero__grid {
      padding-right: 0;
    }
  }

  @media (max-width: 860px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero h1 {
      max-width: 14ch;
    }

    .hero__foto {
      justify-self: stretch;
      width: 100%;
      max-height: 70vh;
      aspect-ratio: 4 / 5;
    }

    .hero__foto :global(img) {
      object-position: center 30%;
    }
  }

  @media (max-width: 520px) {
    .hero__ctas .btn {
      width: 100%;
    }

    .hero__foto {
      aspect-ratio: 3 / 4;
    }
  }
</style>
