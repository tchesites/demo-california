---
import { avaliacoes, negocio } from '../data/negocio.js';
---

<section class="section paper depoimentos" id="depoimentos">
  <div class="container">
    <div class="sec-head" data-reveal>
      <span class="kicker">Depoimentos</span>
      <h2>Quem senta na cadeira, volta.</h2>
      <p>
        A nota é do Google, mas o motivo está na cadeira: acabamento, conversa e
        um ambiente que dá gosto de voltar.
      </p>
    </div>

    <div class="depo__grid">
      <aside class="depo__score" data-reveal>
        <span class="depo__nota num">{negocio.notaGoogle.toFixed(1).replace('.', ',')}</span>
        <span class="depo__stars" aria-hidden="true">★★★★★</span>
        <p>{negocio.totalAvaliacoes} avaliações no Google</p>
        <a href={negocio.googleReviewsUrl} target="_blank" rel="noopener">
          Ver no Google
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2 8h11M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </a>
      </aside>

      <div class="depo__lista">
        {avaliacoes.map((avaliacao) => (
          <article class="depo__card" data-reveal>
            <span class="depo__aspas" aria-hidden="true">“</span>
            <p>{avaliacao.texto}</p>
            <footer>
              <span class="depo__autor">{avaliacao.autor}</span>
              <span class="depo__fonte">Avaliação no Google</span>
            </footer>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .depoimentos {
    background: var(--osso);
    color: var(--preto);
  }

  .depo__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.5fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .depo__score {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    display: grid;
    gap: 0.4rem;
    padding: clamp(1.6rem, 3vw, 2.4rem);
    background: var(--lima);
    border: 1px solid var(--preto);
  }

  .depo__nota {
    font-size: clamp(3.6rem, 7vw, 5.6rem);
    line-height: 0.9;
  }

  .depo__stars {
    color: var(--preto);
    letter-spacing: 0.2em;
    font-size: 0.9rem;
  }

  .depo__score p {
    font-family: var(--fonte-dados);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .depo__score a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.2rem;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--preto);
    font-family: var(--fonte-dados);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .depo__score a:hover {
    color: var(--tijolo);
    border-color: var(--tijolo);
  }

  .depo__score svg {
    width: 13px;
    height: 13px;
  }

  .depo__lista {
    display: grid;
  }

  .depo__card {
    position: relative;
    padding: 1.6rem 0 1.8rem 2.4rem;
    border-top: 1px solid rgba(8, 9, 10, 0.2);
  }

  .depo__card:last-child {
    border-bottom: 1px solid rgba(8, 9, 10, 0.2);
  }

  .depo__aspas {
    position: absolute;
    left: 0;
    top: 1.1rem;
    font-family: var(--fonte-display);
    font-size: 2.4rem;
    line-height: 1;
    color: var(--tijolo);
  }

  .depo__card p {
    max-width: 54ch;
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.5;
  }

  .depo__card footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .depo__autor,
  .depo__fonte {
    font-family: var(--fonte-dados);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .depo__autor {
    font-weight: 500;
  }

  .depo__fonte {
    color: #62645d;
  }

  @media (max-width: 820px) {
    .depo__grid {
      grid-template-columns: 1fr;
    }

    .depo__score {
      position: static;
    }
  }
</style>
