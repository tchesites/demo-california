---
import { whatsappLink } from '../data/negocio.js';

interface Props {
  servico: {
    nome: string;
    descricao: string;
    precoTexto: string;
    destaque: boolean;
  };
  indice: number;
  span: number;
}

const { servico, indice, span } = Astro.props;
const numero = String(indice + 1).padStart(2, '0');
---

<article
  class:list={['card', { 'card--destaque': servico.destaque }]}
  style={`grid-column: span ${span};`}
>
  <div class="card__top">
    <span class="card__num num">{numero}</span>
    <span class="card__tag">{servico.destaque ? 'Destaque' : 'Serviço'}</span>
  </div>

  <h3>{servico.nome}</h3>
  <p>{servico.descricao}</p>

  <div class="card__foot">
    <span class="card__preco">{servico.precoTexto}</span>
    <a
      class="card__link"
      href={whatsappLink(`Olá! Quero marcar ${servico.nome.toLowerCase()} na Califórnia.`)}
      target="_blank"
      rel="noopener"
      aria-label={`Agendar ${servico.nome} no WhatsApp`}
    >
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M2 8h11M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </a>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    min-height: 250px;
    padding: clamp(1.4rem, 3vw, 2.1rem);
    border: 1px solid var(--preto);
    background: transparent;
    color: var(--preto);
    transition:
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }

  .card:hover {
    background: var(--preto);
    color: var(--osso);
    border-color: var(--preto);
  }

  .card--destaque {
    background: var(--lima);
    border-color: var(--lima);
  }

  .card--destaque:hover {
    background: var(--preto);
    border-color: var(--preto);
  }

  .card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .card__num {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    transition: color 0.25s ease;
  }

  .card__tag {
    font-family: var(--fonte-dados);
    font-size: 0.54rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #5d5f58;
  }

  .card:hover .card__tag,
  .card:hover .card__num {
    color: var(--lima);
  }

  .card h3 {
    margin: 1.5rem 0 0.7rem;
    font-family: var(--fonte-display);
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .card p {
    max-width: 42ch;
    color: #4d4f49;
    font-size: 0.95rem;
    transition: color 0.25s ease;
  }

  .card:hover p {
    color: var(--cinza);
  }

  .card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.4rem;
    border-top: 1px solid rgba(8, 9, 10, 0.16);
  }

  .card:hover .card__foot {
    border-top-color: rgba(216, 255, 62, 0.22);
  }

  .card__preco {
    font-family: var(--fonte-dados);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .card__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    flex: none;
    border: 1px solid currentColor;
    border-radius: 50%;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .card__link svg {
    width: 15px;
    height: 15px;
  }

  .card__link:hover {
    background: var(--lima);
    border-color: var(--lima);
    color: var(--preto);
    transform: translateX(2px);
  }

  @media (max-width: 900px) {
    .card {
      grid-column: span 12 !important;
      min-height: 0;
    }
  }
</style>
