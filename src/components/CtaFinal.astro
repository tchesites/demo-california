---
import { whatsappLink } from '../data/negocio.js';
import { url } from '../utils/url.js';
---

<section class="cta">
  <div class="container cta__grid">
    <div class="cta__copy">
      <span class="kicker">Agenda aberta</span>
      <h2>Sai renovado.</h2>
      <p>Chega no WhatsApp e garante teu horário.</p>
    </div>

    <a class="btn btn--dark cta__btn" href={whatsappLink()} target="_blank" rel="noopener">
      Agendar no WhatsApp
      <svg class="btn__arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M2 8h11M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </a>
  </div>

  <img class="cta__logo" src={url('/logo.svg')} alt="" width="320" height="320" />
</section>

<style>
  .cta {
    position: relative;
    padding-block: clamp(4rem, 10vw, 8rem);
    background: var(--lima);
    color: var(--preto);
    overflow: hidden;
  }

  .cta__grid {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .cta .kicker {
    color: var(--preto);
  }

  .cta h2 {
    margin: 0.5rem 0 0.8rem;
    font-family: var(--fonte-display);
    font-size: clamp(3rem, 9vw, 8rem);
    font-weight: 400;
    line-height: 0.82;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .cta p {
    font-family: var(--fonte-dados);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cta__btn {
    flex: none;
    margin-bottom: 0.4rem;
  }

  .cta__logo {
    position: absolute;
    right: -4rem;
    bottom: -6rem;
    width: min(34vw, 320px);
    height: auto;
    opacity: 0.1;
    pointer-events: none;
  }

  @media (max-width: 820px) {
    .cta__grid {
      align-items: flex-start;
      flex-direction: column;
    }

    .cta__btn {
      width: 100%;
    }

    .cta__logo {
      width: 220px;
      right: -3rem;
      bottom: -4rem;
    }
  }
</style>
